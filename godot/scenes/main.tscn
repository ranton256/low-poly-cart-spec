[gd_scene load_steps=8 format=3]

; The game's entry scene: the world, the composition root that drives the
; simulation, the kart, and the chase camera the design document specifies.
;
; The root lives HERE and not in world.tscn, so that world.tscn keeps its
; committed property of rendering with nothing stepping — which is what lets it
; be loaded and captured on its own, and what kart_front_view.tscn and
; kart_overhead_view.tscn depend on. Those scenes keep the PLACEHOLDER viewpoint;
; this one uses the specified camera. See design D4 of add-chase-camera.

[ext_resource type="PackedScene" path="res://scenes/world.tscn" id="1_world"]
[ext_resource type="Script" path="res://scripts/main.gd" id="2_main"]
[ext_resource type="Script" path="res://scripts/view/kart_view.gd" id="3_kart"]
[ext_resource type="Script" path="res://scripts/view/camera_view.gd" id="4_camera"]
[ext_resource type="Script" path="res://scripts/world/prop_field.gd" id="5_props"]
[ext_resource type="Script" path="res://scripts/view/overlay_view.gd" id="6_overlay"]
[ext_resource type="Script" path="res://scripts/view/minimap_view.gd" id="7_minimap"]
[ext_resource type="Script" path="res://scripts/view/gate_view.gd" id="8_gates"]

[node name="Main" type="Node3D"]
script = ExtResource("2_main")

[node name="World" parent="." instance=ExtResource("1_world")]

[node name="Kart" type="Node3D" parent="."]
script = ExtResource("3_kart")

[node name="PropField" type="Node3D" parent="."]
script = ExtResource("5_props")

[node name="Gates" type="Node3D" parent="."]
script = ExtResource("8_gates")

[node name="ChaseCamera" type="Camera3D" parent="."]
script = ExtResource("4_camera")

[node name="Overlay" type="CanvasLayer" parent="."]
script = ExtResource("6_overlay")

[node name="Minimap" type="SubViewportContainer" parent="."]
script = ExtResource("7_minimap")
