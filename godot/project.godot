; Low Poly Cart — Godot port. Settings chosen for CONFORMANCE and TESTABILITY.
;
; Four of these are load-bearing and must not be changed without a proposal.
; See CONSTRAINTS.md at the repository root:
;
;   physics_ticks_per_second  the fixed simulation step. The simulation never
;                             reads frame delta. CONSTRAINTS §6 Determinism and the reference frame.
;   physics_jitter_fix        MUST be 0. Godot's 0.5 default perturbs the
;                             physics delta to smooth frame pacing, which
;                             drifts the race clock against wall time and
;                             breaks acceptance item 14. CONSTRAINTS §6 Determinism and the reference frame.
;   renderer/rendering_method one renderer on EVERY target, so one spec
;                             produces one look and one baseline set.
;                             CONSTRAINTS §2 Tech stack. Confirmed by the change
;                             spike-compatibility-renderer-shadows against five
;                             criteria fixed before the captures were taken;
;                             evidence in godot/docs/progress/.
;   config/features           the Godot SERIES (major.minor) this project is
;                             developed against. Godot stores nothing finer
;                             here, so the full version lives in
;                             .godot-version and check_engine_version.py
;                             keeps the two in step.
;
; Godot rewrites this file when the editor saves, and strips comments when it
; does. If these comments vanish, restore them — they are the only place the
; reasons live.

config_version=5

[application]

config/name="Low Poly Cart"
config/description="A single-player arcade go-kart time trial. A Godot port of the normative game design document at the repository root."
config/version="1.2.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[display]

; A 3D game. The HUD's design resolution is deliberately NOT settled here —
; it is ambiguity A1 in CONSTRAINTS §5 Conformance to the specification, owned by M5, and the stretch settings
; below may change when it is.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=60
common/physics_jitter_fix=0.0

[rendering]

; 16x anisotropic filtering, the document's section 5 (4 = 16x).
textures/default_filters/anisotropic_filtering_level=4

; Required by the macOS arm64 export target; textures themselves are stamped
; Basis Universal (tools/stamp_texture_imports.py), so this only adds the
; engine-side transcoding targets the Apple GPU expects.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

; The design document specifies a 2048 x 2048 shadow map. Godot's desktop
; default is 4096, so leaving this unset silently renders at 4x the specified
; texel count — which is exactly what the first run of
; spike-compatibility-renderer-shadows did, invalidating its verdict. Pinned.
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048

; The design document asks for soft/percentage-closer filtering. Leaving this
; defaulted meant the renderer spike judged "at the specified map AND filtering"
; with only the map half pinned. 3 = Soft High.
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=3

; The design document's control table, Feature: Input Handling / Mapping the
; control scheme. Both key sets are equivalent, as the document requires.
;
; PHYSICAL keycodes, so W/A/S/D stay where the player's fingers are on a
; non-QWERTY layout — the document names key positions, not glyphs.
;
; reset_kart and save_layout are BOUND AND INERT. Their effects belong to M7;
; M2 declares the bindings, which is what the register entry for "Mapping the
; control scheme" records. tools/check_settings.py pins every action and key
; here, because this file is rewritten by the editor and by
; ProjectSettings.save() — both of which have already dropped things from it.

[input]

accelerate={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":87,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194320,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
